{
  "name": "devcollab-frontend",
  "version": "1.0.0",
  "description": "DevCollab 多Agent协作智能软件开发助手系统前端",
  "author": "DevCollab Team",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "pinia": "^2.1.0",
    "axios": "^1.6.0",
    "socket.io-client": "^4.7.0",
    "dayjs": "^1.11.0",
    "lodash-es": "^4.17.0",
    "marked": "^11.0.0",
    "highlight.js": "^11.0.0",
    "element-plus": "^2.3.0",
    "@element-plus/icons-vue": "^2.3.0",
    "naive-ui": "^2.34.0",
    "vxe-table": "^4.0.0",
    "echarts": "^5.4.0",
    "monaco-editor": "^0.44.0",
    "codemirror": "^6.0.0",
    "nprogress": "^0.2.0",
    "js-cookie": "^3.0.0",
    "screenfull": "^6.0.0",
    "clipboard": "^2.0.0",
    "qrcode": "^1.5.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitejs/plugin-vue-jsx": "^3.0.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "sass": "^1.69.0",
    "less": "^4.0.0",
    "postcss": "^8.0.0",
    "autoprefixer": "^10.0.0",
    "tailwindcss": "^3.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-import": "^2.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "vitest": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "jsdom": "^23.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^9.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.0.0",
    "commitizen": "^4.0.0",
    "cz-conventional-changelog": "^3.0.0",
    "standard-version": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/devcollab.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/devcollab/issues"
  },
  "homepage": "https://github.com/your-org/devcollab#readme",
  "keywords": [
    "vue",
    "typescript",
    "vite",
    "ai",
    "agent",
    "collaboration",
    "development"
  ]
}