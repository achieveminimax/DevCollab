# DevCollab 环境变量配置
# 复制此文件为 .env 并填入实际值

# ============ 应用配置 ============
# 应用运行模式
DEBUG=true
ENVIRONMENT=development

# 应用密钥
SECRET_KEY=your-secret-key-change-in-production
API_KEY=your-api-key-for-internal-use

# 服务器配置
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============ 数据库配置 ============
# PostgreSQL
DATABASE_URL=postgresql://devcollab:devcollab@localhost:5432/devcollab
POSTGRES_USER=devcollab
POSTGRES_PASSWORD=devcollab
POSTGRES_DB=devcollab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Milvus 向量数据库
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# ============ LLM API 配置 ============
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4000

# 阿里通义千问
QWEN_API_KEY=qwen-your-api-key-here
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-max
QWEN_MAX_TOKENS=2000

# 本地LLM (Ollama等)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3

# ============ Agent 配置 ============
# Agent 默认配置
AGENT_MAX_ITERATIONS=3
AGENT_TIMEOUT_SECONDS=300
AGENT_THINKING_DEPTH=medium

# PM Agent 配置
PM_AGENT_MODEL=gpt-4o
PM_AGENT_TEMPERATURE=0.3
PM_AGENT_MAX_TOKENS=4000

# Architect Agent 配置
ARCHITECT_AGENT_MODEL=gpt-4o
ARCHITECT_AGENT_TEMPERATURE=0.2
ARCHITECT_AGENT_MAX_TOKENS=8000

# Developer Agent 配置
DEVELOPER_AGENT_MODEL=gpt-4o
DEVELOPER_AGENT_TEMPERATURE=0.1
DEVELOPER_AGENT_MAX_TOKENS=8000

# Tester Agent 配置
TESTER_AGENT_MODEL=gpt-4o
TESTER_AGENT_TEMPERATURE=0.2
TESTER_AGENT_MAX_TOKENS=6000

# Reviewer Agent 配置
REVIEWER_AGENT_MODEL=gpt-4o
REVIEWER_AGENT_TEMPERATURE=0.1
REVIEWER_AGENT_MAX_TOKENS=6000

# ============ 沙箱配置 ============
# 代码执行沙箱
SANDBOX_ENABLED=true
SANDBOX_HOST=localhost
SANDBOX_PORT=8080
MAX_CONCURRENT_EXECUTIONS=10
EXECUTION_TIMEOUT_SECONDS=30
MEMORY_LIMIT_MB=512
CPU_LIMIT=0.5

# Docker 沙箱配置
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_NETWORK=devcollab-network
DOCKER_IMAGE_PYTHON=python:3.11-slim
DOCKER_IMAGE_NODE=node:18-alpine

# ============ 监控配置 ============
# Prometheus
PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_HOST=localhost
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Loki 日志
LOKI_HOST=localhost
LOKI_PORT=3100

# ============ 文件存储配置 ============
# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.py,.js,.ts,.json,.md,.txt,.pdf,.doc,.docx

# 临时文件
TEMP_DIR=./temp
CLEANUP_TEMP_FILES=true
TEMP_FILE_RETENTION_HOURS=24

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_ROTATION_SIZE_MB=100
LOG_BACKUP_COUNT=10

# ============ 性能配置 ============
# 工作线程/进程数
WORKER_COUNT=4
THREAD_POOL_SIZE=10

# 缓存配置
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# 请求限制
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ============ 安全配置 ============
# 身份验证
AUTH_ENABLED=true
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API 密钥验证
API_KEY_REQUIRED=true
API_KEY_HEADER=X-API-Key

# CORS 安全
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ============ 功能开关 ============
# 功能标志
FEATURE_AGENT_COLLABORATION=true
FEATURE_CODE_SANDBOX=true
FEATURE_MEMORY_STORAGE=true
FEATURE_GIT_INTEGRATION=false
FEATURE_DOCUMENT_GENERATION=false
FEATURE_VISUALIZATION=false

# ============ 外部服务集成 ============
# GitHub 集成
GITHUB_TOKEN=your-github-token-here
GITHUB_API_BASE=https://api.github.com

# GitLab 集成
GITLAB_TOKEN=your-gitlab-token-here
GITLAB_API_BASE=https://gitlab.com/api/v4

# 邮件服务
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@devcollab.com

# ============ 开发工具配置 ============
# 代码质量检查
RUFF_ENABLED=true
PYLINT_ENABLED=true
MYPY_ENABLED=true

# 测试配置
TEST_COVERAGE_THRESHOLD=70
TEST_TIMEOUT_SECONDS=30

# 代码格式化
BLACK_ENABLED=true
ISORT_ENABLED=true